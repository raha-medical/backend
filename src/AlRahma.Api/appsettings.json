{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=alrahma;Username=alrahma;Password=CHANGE_ME"
  },
  "Jwt": {
    "Issuer": "alrahma-api",
    "Audience": "alrahma-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenHours": 14,
    "PatientAudience": "alrahma-patients",
    "PatientRefreshDays": 30
  },
  "Otp": {
    "Mode": "sandbox",
    "ExposeCodeInResponse": false
  },
  "Sms": {
    "Mode": "sandbox"
  },
  "Push": {
    "Mode": "sandbox"
  },
  "Payments": {
    "Mode": "sandbox",
    "PublicBaseUrl": "",
    "ExpiryMinutes": 15
  },
  "Jobs": {
    "Enabled": true
  },
  "Cors": {
    "Origins": [
      "http://localhost:3000"
    ]
  },
  "Storage": {
    "ServiceUrl": "http://localhost:9000",
    "PublicUrl": "",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "medical",
    "Region": "us-east-1"
  },
  "Swagger": {
    "Enabled": false
  },
  "Bootstrap": {
    "BranchCode": "B1",
    "BranchName": "الفرع الرئيسي",
    "AdminUsername": "",
    "AdminPassword": ""
  },
  "Backup": {
    "Enabled": false,
    "Repo2Enabled": false,
    "MaxHoursWithoutSuccess": 26,
    "Files": {
      "Mode": "off",
      "MaxLagHours": 24
    }
  }
}
